# Quantora Environment Configuration
# Copy this to .env and fill in your values

# OpenAI (leave blank to run in mock/offline mode)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL / TimescaleDB
DATABASE_URL=postgresql+asyncpg://quantora:quantora@localhost:5432/quantora

# Risk threshold: halt workflow if portfolio CVaR exceeds this fraction (e.g. 0.05 = 5%)
RISK_CVAR_LIMIT=0.05

# CORS origins (comma-separated if multiple)
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]
